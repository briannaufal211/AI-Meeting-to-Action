# Fill in an API key and model IDs available to your account. Never commit .env.
# Rate fields are illustrative estimates, not current vendor prices. Update them.
# Isi sendiri. Jangan mengirim API key melalui chat.
OPENAI_API_KEY=
OPENAI_MODEL=your-text-model-id
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=id
MAX_UPLOAD_MB=300
MAX_AUDIO_MINUTES=120
MAX_CHUNKS=20
API_TIMEOUT_SECONDS=180
NODE_EXE=node
APP_PORT=8765
INPUT_USD_PER_MILLION=0.10
OUTPUT_USD_PER_MILLION=0.50
USD_IDR=18160
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/diskusi

N8N_RESUME_URL=http://127.0.0.1:5678/webhook/diskusi-lanjut

# Pemeriksaan konteks lengkap; maksimal 1 revisi AI + pemeriksaan ulang. Tanpa retry jaringan.
MAX_PAID_CALLS_PER_JOB=12
MAX_AI_REVISIONS=1

# Pekerjaan baru: rekomendasi PPT dan Action Plan Excel lokal.
ENABLE_ACTION_PLAN=1

TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=your-transcription-model-id
TRANSCRIPTION_LANGUAGES=id,en
TRANSCRIPTION_KEYWORDS=
MAX_TRANSCRIPTION_USD_PER_JOB=0.60
TRANSCRIPTION_TIMEOUT_SECONDS=600

SPEAKER_AUDIO_ENABLED=1

# Alamat khusus backend ke workflow unggah, terpisah dari alamat publik n8n.
APP_N8N_JOB_URL=http://127.0.0.1:5678/webhook/diskusi
