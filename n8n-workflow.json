    {
      "id": "upload",
      "name": "Terima MP3",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -650,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "diskusi",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "webhookId": "upload"
    },
