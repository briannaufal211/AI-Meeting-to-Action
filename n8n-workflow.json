      "typeVersion": 4.2,
      "position": [
        -420,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:8765/api/jobs",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "={{ Object.keys($binary)[0] }}"
            },
            {
              "name": "title",
              "value": "={{ $json.body.title || 'Ringkasan diskusi' }}"
            },
            {
              "name": "slide_count",
              "value": "={{ $json.body.slide_count ?? '0' }}"
            },
            {
              "name": "orchestrator",
              "value": "n8n"
            },
            {
              "name": "output_mode",
              "value": "={{ $json.body.output_mode || 'summary_ppt' }}"
            }
          ]
        }
      }
    },
    {
